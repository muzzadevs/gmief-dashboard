generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Zona {
  id       Int       @id @default(autoincrement())
  nombre   String    @db.VarChar(100)
  codigo   String    @db.VarChar(10)
  activo   Boolean   @default(true)
  subzonas Subzona[]
  iglesias Iglesia[]

  @@map("zonas")
}

model Subzona {
  id       Int       @id @default(autoincrement())
  nombre   String    @db.VarChar(100)
  zona_id  Int
  activo   Boolean   @default(true)
  zona     Zona      @relation(fields: [zona_id], references: [id])
  iglesias Iglesia[]

  @@index([zona_id])
  @@map("subzonas")
}

model Iglesia {
  id          Int          @id @default(autoincrement())
  nombre      String       @db.VarChar(100)
  direccion   String?      @db.VarChar(255)
  municipio   String?      @db.VarChar(100)
  provincia   String?      @db.VarChar(100)
  zona_id     Int
  subzona_id  Int?
  cp          Int?
  latitud     Float?
  longitud    Float?
  activo      Boolean      @default(true)
  zona        Zona         @relation(fields: [zona_id], references: [id])
  subzona     Subzona?     @relation(fields: [subzona_id], references: [id])
  ministerios Ministerio[]
  pastor      PastorIglesia?

  @@index([zona_id])
  @@index([subzona_id])
  @@map("iglesias")
}

model Ministerio {
  id                   Int              @id @default(autoincrement())
  nombre               String           @db.VarChar(20)
  apellidos            String?          @db.VarChar(60)
  alias                String?          @db.VarChar(50)
  dni_encrypted        String?          @db.VarChar(255)
  nie_encrypted        String?          @db.VarChar(255)
  iglesia_id           Int
  codigo               String?          @unique(map: "codigo") @db.VarChar(50)
  estado_id            Int
  tipo                 String           @default("MINISTERIO") @db.VarChar(15)
  aprob                Int?
  telefono             String?          @db.VarChar(15)
  email                String?          @db.VarChar(255)
  fecha_nacimiento     DateTime?        @db.Date
  direccion_particular String?          @db.VarChar(255)
  imagen               Bytes?           @db.LongBlob
  activo               Boolean          @default(true)
  username             String?          @unique(map: "username") @db.VarChar(50)
  password_hash        String?          @db.VarChar(255)
  must_change_password Boolean          @default(true)
  iglesia              Iglesia          @relation(fields: [iglesia_id], references: [id])
  estado               Estado           @relation(fields: [estado_id], references: [id])
  cargos               MinisterioCargo[]
  observaciones        Observacion[]
  candidato_detalle    CandidatoDetalle?
  pastor_iglesia       PastorIglesia?
  solicitud_items      SolicitudCredencialItem[]
  historico            MinisterioHistorico[]

  @@index([iglesia_id])
  @@index([estado_id])
  @@index([tipo])
  @@map("ministerios")
}

model MinisterioHistorico {
  id              Int        @id @default(autoincrement())
  ministerio_id   Int
  campo           String     @db.VarChar(50)
  valor_anterior  String?    @db.VarChar(255)
  valor_nuevo     String?    @db.VarChar(255)
  fecha           DateTime   @default(now()) @db.DateTime(3)
  ministerio      Ministerio @relation(fields: [ministerio_id], references: [id], onDelete: Cascade)

  @@index([ministerio_id, fecha])
  @@map("ministerios_historico")
}

model Cargo {
  id          Int              @id @default(autoincrement())
  cargo       String           @db.VarChar(100)
  ministerios MinisterioCargo[]
  roles       RolCargo[]

  @@map("cargos")
}

model Estado {
  id          Int          @id @default(autoincrement())
  nombre      String       @db.VarChar(50)
  ministerios Ministerio[]

  @@map("estados")
}

model MinisterioCargo {
  id            Int        @id @default(autoincrement())
  ministerio_id Int
  cargo_id      Int
  ministerio    Ministerio @relation(fields: [ministerio_id], references: [id])
  cargo         Cargo      @relation(fields: [cargo_id], references: [id])

  @@index([ministerio_id])
  @@index([cargo_id])
  @@map("ministerio_cargo")
}

model Observacion {
  id            Int        @id @default(autoincrement())
  ministerio_id Int
  observacion   String     @db.VarChar(255)
  ministerio    Ministerio @relation(fields: [ministerio_id], references: [id])

  @@index([ministerio_id])
  @@map("observaciones")
}

model CandidatoDetalle {
  id                      Int        @id @default(autoincrement())
  ministerio_id           Int        @unique
  fecha_inicio            DateTime   @db.Date
  fecha_candidato_local   DateTime?  @db.Date
  fecha_candidato_nacional DateTime? @db.Date
  notas                   String?    @db.VarChar(255)
  ministerio              Ministerio @relation(fields: [ministerio_id], references: [id], onDelete: Cascade)

  @@map("candidato_detalle")
}

model PastorIglesia {
  id            Int        @id @default(autoincrement())
  iglesia_id    Int        @unique
  ministerio_id Int        @unique
  iglesia       Iglesia    @relation(fields: [iglesia_id], references: [id])
  ministerio    Ministerio @relation(fields: [ministerio_id], references: [id])

  @@map("pastores_iglesia")
}

model Modulo {
  id          Int              @id @default(autoincrement())
  nombre      String           @db.VarChar(100)
  descripcion String?          @db.VarChar(255)
  icono       String?          @db.VarChar(50)
  href        String           @db.VarChar(255)
  activo      Boolean          @default(true)
  orden       Int              @default(0)
  permisos    RolModuloPermiso[]

  @@map("modulos")
}

model Rol {
  id          Int                @id @default(autoincrement())
  nombre      String             @unique @db.VarChar(50)
  descripcion String?            @db.VarChar(255)
  es_sistema  Boolean            @default(false)
  permisos    RolModuloPermiso[]
  cargos      RolCargo[]

  @@map("roles")
}

model Permiso {
  id          Int                @id @default(autoincrement())
  clave       String             @unique @db.VarChar(50)
  nombre      String             @db.VarChar(100)
  descripcion String?            @db.VarChar(255)
  es_sistema  Boolean            @default(false)
  orden       Int                @default(0)
  asignaciones RolModuloPermiso[]

  @@map("permisos")
}

model RolModuloPermiso {
  id         Int     @id @default(autoincrement())
  rol_id     Int
  modulo_id  Int
  permiso_id Int
  rol        Rol     @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  modulo     Modulo  @relation(fields: [modulo_id], references: [id], onDelete: Cascade)
  permiso    Permiso @relation(fields: [permiso_id], references: [id], onDelete: Cascade)

  @@unique([rol_id, modulo_id, permiso_id])
  @@index([rol_id])
  @@index([modulo_id])
  @@index([permiso_id])
  @@map("rol_modulo_permisos")
}

model RolCargo {
  id       Int   @id @default(autoincrement())
  rol_id   Int
  cargo_id Int
  rol      Rol   @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  cargo    Cargo @relation(fields: [cargo_id], references: [id], onDelete: Cascade)

  @@unique([rol_id, cargo_id])
  @@index([rol_id])
  @@index([cargo_id])
  @@map("rol_cargos")
}

model SolicitudCredencial {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())
  estado      String   @default("PENDIENTE") @db.VarChar(20) // PENDIENTE, EN_PROCESO, COMPLETADA
  notas       String?  @db.VarChar(500)
  items       SolicitudCredencialItem[]

  @@map("solicitudes_credencial")
}

model SolicitudCredencialItem {
  id              Int      @id @default(autoincrement())
  solicitud_id    Int
  ministerio_id   Int
  expedida        Boolean  @default(false)
  fecha_expedicion DateTime?
  solicitud       SolicitudCredencial @relation(fields: [solicitud_id], references: [id], onDelete: Cascade)
  ministerio      Ministerio          @relation(fields: [ministerio_id], references: [id])

  @@index([solicitud_id])
  @@index([ministerio_id])
  @@map("solicitud_credencial_items")
}
